{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["hnd1"],
  "functions": {
    "api/index.ts": { "maxDuration": 300 }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": "/api/index" }
  ],
  "crons": [
    { "path": "/cron/collect",   "schedule": "30 20 * * *" },
    { "path": "/cron/summarize", "schedule": "0 21 * * *" },
    { "path": "/cron/summarize-retry", "schedule": "40 21 * * *" },
    { "path": "/cron/summarize-ahead", "schedule": "0 12 * * *" },
    { "path": "/cron/summarize-ahead-2", "schedule": "0 13 * * *" },
    { "path": "/cron/digest",    "schedule": "0 22 * * *" }
  ]
}
