# HR Daily API 환경변수 (SPEC.md 「환경변수」 참고)
# 로컬: 이 파일을 .env 로 복사해 값을 채운다. Vercel: `vercel env add <NAME>` 으로 등록한다.

# --- Supabase (필수) ---
# 프로젝트 URL. Supabase 대시보드 > Project Settings > API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# service_role 키. RLS 를 우회하므로 절대 프론트에 노출하지 않는다.
SUPABASE_SERVICE_ROLE_KEY=            # 또는 SUPABASE_SERVICE_ROLE_KEY2 (둘 중 먼저 설정된 값 사용)

# --- Google Gemini (summarize 잡에 필수) ---
GEMINI_API_KEY=
# 선택. 기본 gemini-3.8-flash (무료 등급 가능). 품질 우선이면 gemini-4-argon
GEMINI_MODEL=gemini-3.8-flash

# --- 이메일 (선택. 없으면 digest/승인 메일은 skipped 로 기록) ---
RESEND_API_KEY=
# 발신자. Resend 에 인증된 도메인이어야 한다.
EMAIL_FROM="HR Daily <daily@yourdomain.com>"

# --- 크론 보호 (필수) ---
# Vercel Cron 은 이 값을 `Authorization: Bearer <CRON_SECRET>` 로 보낸다. 관리자 API 와 무관.
# 생성 예: openssl rand -hex 32
CRON_SECRET=

# --- 관리자 부트스트랩 (필수) ---
# 쉼표 구분. 여기 있는 이메일은 요청 시 자동으로 role=admin, status=approved 로 승격된다.
ADMIN_EMAILS=you@example.com

# --- 프론트 주소 (필수) ---
# CORS 허용 오리진 + 메일의 "앱에서 읽기" 링크. 끝에 슬래시 없이.
WEB_URL=https://hr-daily.vercel.app

# --- 로컬 개발 전용 (선택) ---
# scripts/dev.ts 포트. 기본 8787
PORT=8787
